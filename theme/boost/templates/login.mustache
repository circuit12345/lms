{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper">

    {{{ output.standard_top_of_body_html }}}

    <!-- Split layout container -->
    <div style="display: grid; grid-template-columns: 3fr 1fr; height: 100vh;">

        <!-- Left Side (Image + Overlay Text) -->
        <div style="background: url('{{{ config.wwwroot }}}/theme/boost/pix/login_image.jpg') no-repeat center center; background-size: cover; position: relative;">
            <div style="background: rgba(0,0,0,0.4); color: white; height: 100%; display: flex; flex-direction: column; justify-content: center; padding: 40px;">
       <div style="position: sticky; top: 0; color: white; padding: 20px; z-index: 10;">
            <h1 style="font-size: 2rem; margin: 0;">Circuit Makers <span style="color:#007BFF;">Laboratory</span></h1><br>     
            <p>A Circuit Makers  portal is a platform where users can browse, enroll in, and access a wide variety of educational courses. It provides a centralized hub for learning with video lessons, quizzes, and progress tracking.</p>
         </div> 
            </div>
        </div>

        <!-- Right Side (Login Form) -->
        <div style="justify-content: center; align-items: center; width:400px; padding: 40px;">
        <h1 style="font-size: 2rem; margin-top: 0; color:#C0C0C0;">Circuit Makers <br><span style="color:#007BFF;font-weight: bold;margin-top:0; ">Laboratory</span></h1><br><br>
         <h1 style="font-size: 2rem; text-align:center; font-weight: bold;">Hi, Welcome to </span><span style= "text-align:center;">Circuit Makers Laboratory</span></span></h1><br>
            <p style="color:#C0C0C0; text-align:center">Enter your details to login in your account</span></p><br>
            <h6 style="color:#C0C0C0; text-align:center">Click to log in with any role</span></h6><br>

<div style="display: flex; justify-content: center; gap: 40px;">
    <!-- Student -->
    <div style="text-align: center; cursor: pointer;">
        <img src="/theme/boost/pix/student_image.jpg" alt="Student" 
             style="width: 100px; height: 100px; border-radius: 50%; border: 2px solid #000000; object-fit: cover;">
        <span style="color:#007BFF; font-weight: bold; display: block; margin-top: 10px;">Student</span>
    </div>

    <!-- Teacher -->
    <div style="text-align: center; cursor: pointer;">
        <img src="/theme/boost/pix/teacher_image.jpg" alt="Teacher" 
             style="width: 100px; height: 100px; border-radius: 50%; border: 2px solid #000000; object-fit: cover;">
        <span style="color:#007BFF; font-weight: bold; display: block; margin-top: 10px;">Teacher</span>
    </div>
</div><br>

<div style="display: flex; justify-content: center; gap: 40px;">
    <!-- Manager -->
    <div style="text-align: center; cursor: pointer;">
        <img src="/theme/boost/pix/manager_image.jpg" alt="Student" 
             style="width: 100px; height: 100px; border-radius: 50%; border: 2px solid #000000; object-fit: cover;">
        <span style="color:#007BFF; font-weight: bold; display: block; margin-top: 10px;">Manager</span>
    </div>
    
    <!-- Admin -->
    <div style="text-align: center; cursor: pointer;">
        <img src="/theme/boost/pix/admin_image.jpg" alt="Teacher" 
             style="width: 100px; height: 100px; border-radius: 50%; border: 2px solid #000000; object-fit: cover;">
        <span style="color:#007BFF; font-weight: bold; display: block; margin-top: 10px;">Admin</span>
    </div>
</div><br><br>

            <div> 
                 {{{ output.main_content }}}
            </div>
        </div>


    </div>

    {{> theme_boost/footer }}
</div>

</body>
</html>

{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
