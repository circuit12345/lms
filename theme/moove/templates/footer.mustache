<footer id="page-footer" class="footer-popover" style="background: linear-gradient(to right, #1F4C8C, #50C878); color: #fff; padding: 32px 0;">
    <div class="moove-container-fluid footer-columns">
        <div class="row align-items-center">

            <!-- Logo Left Side -->
            <div class="col-md-3 column-left text-left">
                <a href="https://www.circuitmakers.in" target="_blank" style="display:inline-block">
                    <img src="{{config.wwwroot}}/theme/moove/pix/logo_circuitmakers.svg" alt="CML Tech Solutions" style="height:56px;">
                </a>
            </div>

            <!-- Center: Company Name & Contact -->
            <div class="col-md-6 column-center text-center">
                <h3 style="font-weight:700; font-size: 1.45rem; margin:0 0 10px 0; letter-spacing:1px; color: #fff;">
                    CML TECH SOLUTIONS PVT LTD
                </h3>
                <a href="https://www.circuitmakers.in"
                    style="color:#E6FFF5;font-size:1.05rem;font-weight:500;text-decoration:none;">
                    www.circuitmakers.in
                </a>
                {{# output.supportemail }}
                    <div class="supportemail mt-2" style="color:#09bc87;font-size:1rem;">{{{ output.supportemail }}}</div>
                {{/ output.supportemail }}
                {{{ output.login_info }}}
                {{{ output.standard_footer_html }}}
            </div>

            <!-- Right: Social Icons -->
            <div class="col-md-3 column-right text-right">
                <div class="socialnetworks" style="display:flex; justify-content:flex-end; gap:18px;">
                    <a href="https://facebook.com/circuitmakers" target="_blank" title="Facebook"
                        style="width:40px; height:40px; background:linear-gradient(135deg,#50C878,#00cc99);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                        <i class="fa fa-facebook"></i>
                    </a>
                    <a href="https://linkedin.com/company/circuitmakers" target="_blank" title="LinkedIn"
                        style="width:40px; height:40px; background:linear-gradient(135deg,#1F4C8C,#50C878);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                        <i class="fa fa-linkedin"></i>
                    </a>
                    <a href="https://instagram.com/circuitmakers.in" target="_blank" title="Instagram"
                        style="width:40px; height:40px; background:linear-gradient(135deg,#00cc99,#7a32c2);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;">
                        <i class="fa fa-instagram"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="footer-content-debugging footer-dark bg-dark text-light">
        <div class="moove-container-fluid footer-dark-inner">
            {{{ output.debug_footer_html }}}
        </div>
    </div>

    <div class="footer-content-popover container" data-region="footer-content-popover">
        {{# output.has_popover_links }}
            <div class="footer-section p-3 border-bottom">
                {{# output.page_doc_link }}
                    <div>{{{ output.page_doc_link }}}</div>
                {{/ output.page_doc_link }}
                {{# output.services_support_link }}
                    <div>{{{ output.services_support_link }}}</div>
                {{/ output.services_support_link }}
            </div>
        {{/ output.has_popover_links }}
        <div class="footer-section p-3">
            <div>{{#str}}poweredbymoodle, core{{/str}}</div>
            {{#output.moodle_release}}
                <div>
                    {{#str}}version, core{{/str}} {{{ output.moodle_release }}}
                </div>
            {{/output.moodle_release}}
        </div>
    </div>

    {{{ output.standard_end_of_body_html }}}

    {{#js}}
        require(['theme_boost/footer-popover'], function(FooterPopover) {
            FooterPopover.init();
        });
    {{/js}}
</footer>
