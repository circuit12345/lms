a:413:{s:29:"auth_edwiserbridgedescription";s:0:"";s:5:"blank";s:0:"";s:10:"modulename";s:14:"Edwiser Bridge";s:15:"modulename_help";s:0:"";s:16:"modulenameplural";s:14:"Edwiser Bridge";s:20:"pluginadministration";s:28:"Edwiser Bridge administrator";s:10:"pluginname";s:14:"Edwiser Bridge";s:7:"summary";s:7:"Summary";s:8:"tab_conn";s:14:"Wordpress Site";s:25:"tab_mdl_required_settings";s:7:"General";s:11:"tab_service";s:11:"Web Service";s:7:"tab_sso";s:3:"SSO";s:9:"tab_synch";s:15:"Synchronization";s:10:"lang_label";s:13:"Language Code";s:22:"wp_site_settings_title";s:15:"Site Settings :";s:8:"nav_name";s:8:"Settings";s:20:"default_settings_nav";s:8:"Settings";s:9:"run_setup";s:16:"Run Setup Wizard";s:13:"edwiserbridge";s:14:"Edwiser Bridge";s:21:"eb-setting-page-title";s:47:"Edwiser Bridge Two Way Synchronization Settings";s:26:"eb-setting-page-title_help";s:47:"Edwiser Bridge Two Way Synchronization Settings";s:19:"eb-setup-page-title";s:27:"Edwiser Bridge Setup Wizard";s:24:"eb-setup-page-title_help";s:27:"Edwiser Bridge Setup Wizard";s:19:"enrollment_checkbox";s:16:"User Enrollment.";s:24:"enrollment_checkbox_desc";s:54:"Enroll user from Moodle to Wordpress for linked users.";s:21:"unenrollment_checkbox";s:18:"User Unenrollment.";s:26:"unenrollment_checkbox_desc";s:56:"Unenroll user from Moodle to Wordpress for linked users.";s:22:"user_creation_checkbox";s:13:"User Creation";s:27:"user_creation_checkbox_desc";s:65:"Create user In linked Wordpress site when created in Moodle Site.";s:22:"user_deletion_checkbox";s:13:"User Deletion";s:27:"user_deletion_checkbox_desc";s:65:"Delete user In linked Wordpress site when deleted in Moodle Site.";s:24:"course_creation_checkbox";s:15:"Course Creation";s:29:"course_creation_checkbox_desc";s:42:"This will create course in Wordpress site.";s:24:"course_deletion_checkbox";s:15:"Course Deletion";s:29:"course_deletion_checkbox_desc";s:85:"This won't delete course but it will mark course as deleted in linked Wordpress site.";s:22:"user_updation_checkbox";s:11:"User Update";s:27:"user_updation_checkbox_desc";s:90:"This will update user first name, last name, email and password and won't update username.";s:19:"wp_settings_section";s:29:"Wordpress Connection Settings";s:13:"wordpress_url";s:13:"Wordpress URL";s:8:"wp_token";s:19:"Moodle Access Token";s:16:"wp_test_conn_btn";s:15:"Test Connection";s:19:"wp_test_remove_site";s:11:"Remove Site";s:14:"add_more_sites";s:12:"Add New Site";s:19:"wordpress_site_name";s:9:"Site Name";s:9:"site-list";s:15:"Wordpress Sites";s:4:"next";s:4:"Next";s:4:"save";s:4:"Save";s:9:"save_cont";s:17:"Save and Continue";s:10:"token_help";s:71:"Please enter the access token generated while creating the web service.";s:24:"wordpress_site_name_help";s:30:"Please enter unique site name.";s:18:"wordpress_url_help";s:32:"Please enter Wordpress site URL.";s:25:"existing_web_service_desc";s:56:"Select existing web service if you have created already.";s:20:"new_web_service_desc";s:22:"Create new web service";s:19:"new_web_new_service";s:22:"Create new web service";s:19:"new_service_inp_lbl";s:24:"Name for the Web Service";s:20:"new_service_user_lbl";s:11:"Select User";s:20:"existing_service_lbl";s:18:"Select web service";s:18:"token_dropdown_lbl";s:12:"Select Token";s:17:"web_service_token";s:38:"Token generated after creating service";s:10:"moodle_url";s:16:"Moodle site URL.";s:16:"web_service_name";s:16:"Web Service Name";s:21:"web_service_auth_user";s:16:"Authorized user.";s:14:"auth_user_desc";s:61:"All admin users used as Authorized User while creating token.";s:21:"existing_service_desc";s:104:"Edwiser web-service functions will get added into it and also be used as reference for upcoming updates.";s:15:"eb_settings_msg";s:34:"To complete Edwiser Bridge Set up ";s:10:"click_here";s:12:" Click Here ";s:12:"eb_dummy_msg";s:19:"Set up Wizard field";s:21:"eb_mform_service_desc";s:12:"Service desc";s:26:"eb_mform_service_desc_help";s:104:"Edwiser web-service functions will get added into it and also be used as reference for upcoming updates.";s:19:"eb_mform_token_desc";s:16:"Webservice Token";s:24:"eb_mform_token_desc_help";s:64:"This is your last created token used in wp for site integration.";s:21:"eb_mform_ur_desc_help";s:113:"Please copy this URL and paste it to your Wordpress site to complete the connection between Moodle and Wordpress.";s:16:"eb_mform_ur_desc";s:8:"Site URL";s:23:"eb_mform_lang_desc_help";s:123:"Please copy this language code and paste it to your Wordpress site to complete the connection between Moodle and Wordpress.";s:18:"eb_mform_lang_desc";s:18:"Site Language Code";s:28:"create_service_shortname_err";s:61:"Unable to create the web service please contact plugin owner.";s:23:"create_service_name_err";s:54:"This name is already in use please use different name.";s:27:"create_service_creation_err";s:61:"Unable to create the web service please contact plugin owner.";s:16:"empty_userid_err";s:23:"Please select the user.";s:15:"eb_link_success";s:32:"Web service successfully linked.";s:11:"eb_link_err";s:31:"Unable to link the web service.";s:21:"eb_service_select_err";s:41:"Please select valid external web service.";s:21:"eb_service_info_error";s:125:" service functions missing in your currently selected service, Please Update service to add all missing webservice functions.";s:12:"dialog_title";s:13:"Token And Url";s:8:"site_url";s:9:"Site Url ";s:5:"token";s:6:"Token ";s:4:"copy";s:4:"Copy";s:6:"copied";s:10:"Copied !!!";s:6:"create";s:18:"Create Web Service";s:14:"create_wp_site";s:10:"- Create -";s:4:"link";s:18:"Update Web Service";s:13:"click_to_copy";s:14:"Click to copy.";s:11:"pop_up_info";s:93:"Copy Moodle site URL and the token to your Wordpress site Edwiser Bridge connection settings.";s:8:"required";s:31:"- You must supply a value here.";s:24:"sitename-duplicate-value";s:62:" - Site Name already exists, Please provide a different value.";s:19:"url-duplicate-value";s:66:" - Wordpress Url already exists, Please provide a different value.";s:18:"web_service_wp_url";s:19:"Wordpress site URL.";s:20:"web_service_wp_token";s:18:"Web service token.";s:21:"web_service_test_conn";s:33:"Web service test connection type.";s:28:"web_service_test_conn_status";s:44:"1 if successful connection and 0 on failure.";s:25:"web_service_test_conn_msg";s:25:"Success or error message.";s:22:"web_service_site_index";s:67:"Site index is the nth no. of site saved in Edwiser Bridge settings.";s:29:"web_service_course_enrollment";s:63:"Checks if the course enrollment is performed for the saved site";s:32:"web_service_course_un_enrollment";s:66:"Checks if the course un-enrollment is performed for the saved site";s:25:"web_service_user_creation";s:59:"Checks if the user creation is performed for the saved site";s:25:"web_service_user_deletion";s:59:"Checks if the user deletion is performed for the saved site";s:27:"web_service_course_creation";s:63:"Checks if Edwiser Bridge 2 way sync course creation is enabled.";s:27:"web_service_course_deletion";s:63:"Checks if Edwiser Bridge 2 way sync course deletion is enabled.";s:23:"web_service_user_update";s:59:"Checks if Edwiser Bridge 2 way sync user update is enabled.";s:18:"web_service_offset";s:40:"This is the offset for the select query.";s:17:"web_service_limit";s:41:"This limits the number of users returned.";s:25:"web_service_search_string";s:49:"This string will be searched in the select query.";s:23:"web_service_total_users";s:40:"Total number of users present in Moodle.";s:14:"web_service_id";s:8:"User Id.";s:20:"web_service_username";s:21:"Username of the user.";s:21:"web_service_firstname";s:23:"First name of the user.";s:20:"web_service_lastname";s:22:"Last name of the user.";s:17:"web_service_email";s:18:"Email of the user.";s:14:"eb_plugin_name";s:11:"Plugin Name";s:17:"eb_plugin_version";s:14:"Plugin Version";s:25:"web_service_rest_protocol";s:34:"Check if rest protocol is enabled.";s:23:"web_service_web_service";s:41:"Check if web services setting is enabled.";s:25:"web_service_extended_char";s:53:"Check if extended characters are allowed in username.";s:27:"web_service_password_policy";s:36:"Check if password policy is enabled.";s:21:"web_service_lang_code";s:53:"check what is the default language code for the site.";s:27:"web_service_student_role_id";s:32:"Default role id of student role.";s:20:"web_service_courseid";s:10:"Course ID.";s:20:"web_service_fullname";s:12:"Course Name.";s:22:"web_service_categoryid";s:26:"Category Id of the course.";s:25:"web_service_total_courses";s:42:"Total number of courses present in Moodle.";s:21:"web_service_cohort_id";s:41:"Cohort id which will be deleted in Moodle";s:28:"web_service_operation_status";s:47:"Operation status (1 for success, 0 for failure)";s:28:"web_service_manual_enrolment";s:59:"Returns 1 if manual enrolment is enabled and 0 if disabled.";s:19:"web_service_user_id";s:27:"User ID to get progress for";s:33:"web_service_completion_percentage";s:34:"Completion percentage of the user.";s:27:"web_service_cohort_courseid";s:42:"Course Id in which cohort wil be enrolled.";s:27:"web_service_course_cohortid";s:47:"Cohort Id which will be enrolled in the course.";s:27:"web_service_course_unenroll";s:51:"If true, cohort will be unenrolled from the course.";s:23:"web_service_instance_id";s:18:"Id of the instance";s:20:"api_cohort_not_found";s:22:"Cohort does not exist.";s:32:"setup_wizard_next_step_html_data";s:36:"Setup wizards next step html content";s:28:"setup_wizard_next_step_title";s:29:"Setup wizards next step title";s:26:"wp_test_connection_success";s:21:"Connection Successful";s:30:"web_service_test_conn_warnings";s:8:"Warnings";s:29:"web_service_test_conn_warning";s:7:"warning";s:13:"default_error";s:193:"Please check the URL or wordpress site permalink: to know more about this error <a href='https://edwiser.helpscoutdocs.com/collection/85-edwiser-bridge-plugin'  target='_blank'> click here </a>";s:13:"wp_site_error";s:93:"HTML response received from WordPress. Please make sure the WordPress site is up and running.";s:14:"bitninja_error";s:83:"Request blocked by BitNinja. Please whitelist the IP address of your Moodle server.";s:16:"cloudflare_error";s:85:"Request blocked by Cloudflare. Please whitelist the IP address of your Moodle server.";s:17:"modsecurity_error";s:87:"Request blocked by Mod Security. Please whitelist the IP address of your Moodle server.";s:17:"eb_empty_name_err";s:32:"Please enter valid service name.";s:17:"eb_empty_user_err";s:19:"Please select user.";s:13:"please_enable";s:41:"Error : Please fix this issue in settings";s:18:"password_policy_cb";s:16:"Password Policy.";s:23:"password_policy_cb_desc";s:231:"If enabled, user passwords will be checked against the password policy as specified in the settings below. Enabling the password policy will not affect existing users until they decide to, or are required to, change their password.";s:25:"extended_char_username_cb";s:39:"Allow extended characters in usernames.";s:30:"extended_char_username_cb_desc";s:273:"Enable this setting to allow students to use any characters in their usernames (note this does not affect their actual names). The default is 'false' which restricts usernames to be alphanumeric lowercase characters, underscore (_), hyphen (-), period (.) or at symbol (@).";s:14:"web_service_cb";s:20:"Enable Web Services.";s:19:"web_service_cb_desc";s:15:"Recommended:yes";s:20:"web_rest_protocol_cb";s:21:"Enable REST Protocol.";s:25:"web_rest_protocol_cb_desc";s:15:"Recommended:yes";s:24:"enable_auto_update_check";s:25:"Enable Auto Update Check.";s:29:"enable_auto_update_check_desc";s:167:"This will enable auto update check for the plugin. When enabled, the plugin will check for updates automatically and show a notification in the Moodle admin dashboard.";s:17:"sum_rest_protocol";s:13:"Rest Protocol";s:16:"sum_web_services";s:11:"Web Service";s:15:"sum_pass_policy";s:15:"Password Policy";s:17:"sum_extended_char";s:37:"Allow Extended Characters In Username";s:16:"sum_service_link";s:14:"Service Linked";s:14:"sum_token_link";s:12:"Token Linked";s:18:"web_service_status";s:20:"Web Service Function";s:22:"test_connection_status";s:17:"Connection Status";s:15:"web_service_cap";s:10:"Capability";s:23:"sum_error_rest_protocol";s:34:"Error: Please enable Rest Protocol";s:22:"sum_error_web_services";s:32:"Error: Please enable Web Service";s:21:"sum_error_pass_policy";s:37:"Error: Please disable Password Policy";s:23:"sum_error_extended_char";s:58:"Error: Please enable Allow Extended Characters in username";s:22:"sum_error_service_link";s:38:"Error: Please update Service and Token";s:20:"sum_error_token_link";s:27:"Error: Please update Token ";s:4:"here";s:6:" here ";s:23:"summary_setting_section";s:24:"General Settings Summary";s:26:"summary_connection_section";s:27:"Connection Settings Summary";s:29:"edwiser_bridge_plugin_summary";s:29:"Edwiser Bridge Plugin Summary";s:7:"enabled";s:7:"Enabled";s:8:"disabled";s:8:"Disabled";s:7:"mdl_url";s:10:"Moodle URL";s:25:"wp_test_connection_failed";s:233:"Server rewrite rules are not enabled or Wordpress permalink is not postname. Also, check if you have any firewall or security plugin, If yes  Whitelist Moodle URL and IP. If this does not fix then connect with your Hosting providers.";s:19:"manual_notification";s:19:"MANUAL NOTIFICATION";s:18:"service_name_empty";s:29:"Please enter web service name";s:10:"user_empty";s:18:"Please select User";s:11:"token_empty";s:19:"Please select Token";s:27:"web_service_creation_status";s:27:"Web service creation status";s:24:"web_service_creation_msg";s:28:"Web service creation message";s:19:"web_service_api_msg";s:7:"message";s:24:"privacy:metadata:wp_site";s:266:"In order to integrate with a WordPress site, user data needs to be exchanged with WordPress. Which will perform actions like user creation, user deletion, user metedata update, user enrollment synchronization and user un-enrollment synchronization on WordPress site.";s:31:"privacy:metadata:wp_site:userid";s:115:"The userid is sent from Moodle to perform any of the actions mentioned in above site description on WordPress site.";s:30:"privacy:metadata:wp_site:email";s:124:"Your email is sent to the WordPress site to perform any of the actions mentioned in above site description on WordPress site";s:33:"privacy:metadata:wp_site:username";s:116:"The username is sent from Moodle to perform any of the actions mentioned in above site description on WordPress site";s:34:"privacy:metadata:wp_site:firstname";s:118:"The first name is sent from Moodle to perform any of the actions mentioned in above site description on WordPress site";s:33:"privacy:metadata:wp_site:lastname";s:117:"The last name is sent from Moodle to perform any of the actions mentioned in above site description on WordPress site";s:33:"privacy:metadata:wp_site:password";s:116:"The password is sent from Moodle to perform any of the actions mentioned in above site description on WordPress site";s:32:"privacy:metadata:wp_site:country";s:115:"The country is sent from Moodle to perform any of the actions mentioned in above site description on WordPress site";s:29:"privacy:metadata:wp_site:city";s:112:"The city is sent from Moodle to perform any of the actions mentioned in above site description on WordPress site";s:30:"privacy:metadata:wp_site:phone";s:113:"The phone is sent from Moodle to perform any of the actions mentioned in above site description on WordPress site";s:38:"privacy:metadata:wp_site:custom_fields";s:126:"The custom fields data is sent from Moodle to perform any of the actions mentioned in above site description on WordPress site";s:22:"mdl_edwiser_bridge_lbl";s:22:"Edwiser Bridge Moodle:";s:18:"eb_pro_license_lbl";s:41:"Edwiser Bridge Pro License key activation";s:19:"eb_pro_license_desc";s:139:"To enable the Edwiser Bridge Pro Features, enter and activate the Edwiser Bridge Pro Moodle license key below. You can find the license key";s:25:"mdl_edwiser_bridge_bp_lbl";s:36:"Edwiser Bridge Bulk Purchase Moodle:";s:26:"mdl_edwiser_bridge_sso_lbl";s:37:"Edwiser Bridge Single Sign On Moodle:";s:29:"mdl_edwiser_bridge_txt_latest";s:6:"Latest";s:31:"mdl_edwiser_bridge_txt_download";s:8:"Download";s:36:"mdl_edwiser_bridge_txt_download_help";s:39:"Click here to download the plugin file.";s:31:"mdl_edwiser_bridge_txt_not_avbl";s:13:"Not Available";s:29:"mdl_edwiser_bridge_fetch_info";s:16:"Check for update";s:11:"eb_no_sites";s:26:"--- No Sites Available ---";s:9:"eb_active";s:6:"Active";s:10:"deactivate";s:18:"Deactivate License";s:8:"activate";s:16:"Activate License";s:15:"license_expired";s:19:"License key expired";s:15:"license_revoked";s:36:"License is disabled from edwiser.org";s:15:"license_invalid";s:22:"License key is invalid";s:14:"license_failed";s:25:"License activation failed";s:26:"license_no_activation_left";s:36:"license key activation limit reached";s:12:"setup_footer";s:78:"Copyright © 2022 Edwiser | Brought to you by WisdmLabs and Powered by Edwiser";s:16:"setup_contact_us";s:10:"Contact Us";s:24:"setup_installation_note1";s:90:"To start the setup you need to have the following plugins installed on WordPress & Moodle.";s:24:"setup_installation_note2";s:93:"If you have already installed Edwiser Bridge FREE plugin on WordPress & Moodle, please click ";s:15:"setup_wp_plugin";s:16:"WordPress Plugin";s:16:"setup_mdl_plugin";s:13:"Moodle Plugin";s:10:"setup_free";s:4:"Free";s:18:"setup_continue_btn";s:18:"Continue the setup";s:22:"continue_wp_wizard_btn";s:27:"Continue Setup on WordPress";s:22:"install_plugins_failed";s:27:"Plugin installation failed.";s:14:"plugininactive";s:23:"The plugin is inactive.";s:22:"setup_installation_faq";s:52:"What to do if I have not installed Wordpress Plugin ";s:25:"setup_faq_download_plugin";s:23:"Download the plugin now";s:15:"setup_faq_steps";s:45:"After download please follow the steps below;";s:15:"setup_faq_step1";s:55:"Login to your WordPress site with Administrative access";s:15:"setup_faq_step2";s:56:"Navigate to Admin dashboard > Plugins > Install plugins ";s:15:"setup_faq_step3";s:52:"Upload the Edwiser Bridge FREE WordPress plugin here";s:15:"setup_faq_step4";s:56:"We will assist you with the rest of the setup from there";s:4:"no_1";s:1:"1";s:4:"no_2";s:1:"2";s:4:"no_3";s:1:"3";s:4:"no_4";s:1:"4";s:22:"setup_mdl_plugin_note1";s:86:"These are mandatory Moodle settings for Edwiser Bridge to work flawlessly on your end.";s:22:"setup_mdl_plugin_note2";s:36:"Once you are ready, please click on.";s:23:"setup_mdl_plugin_check1";s:22:"Enabling Rest Protocol";s:23:"setup_mdl_plugin_check2";s:20:"Enabling Web Service";s:23:"setup_mdl_plugin_check3";s:23:"Disable Password Policy";s:23:"setup_mdl_plugin_check4";s:38:"Allow extended characters in usernames";s:30:"setup_mdl_settings_success_msg";s:60:"The mandatory Moodle settings has been enabled successfully!";s:21:"setup_enable_settings";s:19:"Enable the Settings";s:23:"setup_web_service_note1";s:86:"Web service configuration is required for connecting Moodle with your WordPress site. ";s:20:"setup_web_service_h1";s:112:"You can ‘create a new web service’ by selecting from the dropdown if you are configuring for the first time.";s:20:"setup_web_service_h2";s:104:"Select an existing web service from the dropdown if you have previously configured Edwiser Bridge plugin";s:19:"setup_wp_site_note1";s:72:"Select the WordPress site that needs to be connected to your Moodle site";s:19:"setup_wp_site_note2";s:39:"Add your WordPress website name and URL";s:22:"setup_wp_site_dropdown";s:18:"The WordPress Site";s:4:"name";s:4:"Name";s:3:"url";s:3:"URL";s:21:"setup_permalink_note1";s:55:"Check and confirm if the permalink structure is set to ";s:11:"es_postname";s:15:"‘Postname’.";s:21:"setup_permalink_click";s:13:"Click on the ";s:21:"setup_permalink_note2";s:67:" link. It will open in a new tab and check the permalink structure.";s:21:"setup_permalink_note3";s:38:"Click on “Confirmed” once checked.";s:9:"confirmed";s:9:"Confirmed";s:4:"back";s:4:"Back";s:4:"skip";s:4:"Skip";s:16:"setup_sync_note1";s:61:"Set your Moodle to WordPress data synchronization preferences";s:10:"select_all";s:10:"Select all";s:11:"recommended";s:13:"(Recommended)";s:15:"user_enrollment";s:15:"User enrollment";s:17:"user_unenrollment";s:17:"User unenrollment";s:13:"user_creation";s:13:"User Creation";s:13:"user_deletion";s:13:"User Deletion";s:11:"user_update";s:11:"User Update";s:15:"course_creation";s:15:"Course Creation";s:15:"course_deletion";s:15:"Course Deletion";s:22:"web_service_courselist";s:18:"List of course IDs";s:9:"what_next";s:10:"What Next?";s:22:"setup_completion_note1";s:74:"You need to add Moodle credentials to Edwiser Bridge FREE WordPress setup.";s:22:"setup_completion_note2";s:107:"Copy and Save the following moodle credential to add details on Edwiser Bridge FREE WordPress plugin setup ";s:22:"setup_completion_note3";s:90:"Alternately, you can download the Edwiser Bridge Moodle ‘Credentials file’ from here. ";s:22:"setup_completion_note4";s:134:"Once you have saved the details please continue with the Edwiser Bridge FREE WordPress setup by clicking on “Continue the setup”. ";s:22:"setup_completion_note5";s:46:"Edwiser Bridge FREE plugin Setup is Completed.";s:20:"wp_site_details_note";s:63:"Click on ‘Test connection’ once you have added the details.";s:2:"or";s:2:"OR";s:6:"select";s:6:"Select";s:20:"setup_test_conn_succ";s:41:"Moodle to WordPress connection successful";s:21:"setup_test_conn_error";s:42:"Please check WordPress site configuration.";s:17:"enabling_rest_tip";s:80:"Enables Moodle Site to communicate with the Wordpress site via API (Recommended)";s:20:"enabling_service_tip";s:80:"Moodle's API service to enable connection from WordPress to Moodle (Recommended)";s:24:"disable_passw_policy_tip";s:269:"- We Recommend disabling this setting.
- If enabled, it will check user passwords against the password policy as specified in the settings.
- ​Enabling the password policy will not affect existing users until they decide to, or are required to, change their password.";s:19:"allow_exte_char_tip";s:267:"Enabling this will allow users to use any characters in their usernames (note this does not affect their actual names).
The default is 'false' which restricts usernames to be alphanumeric lowercase characters, underscore (_), hyphen (-), period (.), or at symbol (@).";s:15:"web_service_tip";s:89:"Its an API service which enables proper communication between WordPress and Moodle sites.";s:20:"name_web_service_tip";s:57:"Setup a name for the Web Service for e.g. 'EdwiserBridge'";s:11:"wp_site_tip";s:69:"Select the WordPress site you wish to integrate with the Moodle site.";s:16:"wp_site_name_tip";s:33:"Key in your WordPress sites name.";s:15:"wp_site_url_tip";s:104:"Ensure there is no blank space. And it should follow the URL with Hypertext Transfer Protocol 'https://'";s:19:"user_enrollment_tip";s:85:"It will auto enroll the users from Moodle to Wordpress. Only applies to linked users.";s:21:"user_unenrollment_tip";s:87:"It will auto unenroll the users from Moodle to Wordpress. Only applies to linked users.";s:17:"user_creation_tip";s:52:"This will auto-create user in linked Wordpress site.";s:17:"user_deletion_tip";s:74:"Deletes the user in the linked Wordpress site when deleted in Moodle Site.";s:15:"user_update_tip";s:93:"This will update user first name, last name and password and won't update Username and Email.";s:19:"course_creation_tip";s:94:"This will draft the course on the linked WordPress site and the course will have to published.";s:19:"course_deletion_tip";s:64:"It will mark the course as deleted in the linked WordPress site.";s:11:"close_quest";s:70:"Are you sure you want to close the Edwiser Bridge Moodle setup wizard?";s:3:"yes";s:3:"Yes";s:2:"no";s:2:"No";s:4:"note";s:4:"Note";s:10:"close_note";s:120:"You can run the setup wizard again by navigating to Moodle Administration > Plugins > Edwiser Bridge > Run Setup wizard.";s:28:"auth_edwiserbridge_secretkey";s:10:"Secret Key";s:33:"auth_edwiserbridge_secretkey_help";s:115:"Set a unique alphanumeric password as Secret key & copy-paste it in WordPress, under the same setting (Secret Key).";s:36:"auth_edwiserbridge_auto_generate_key";s:13:"Auto Generate";s:15:"eb_sso_settings";s:27:"Edwiser Bridge SSO Settings";s:28:"auth_edwiserbridge_wpsiteurl";s:18:"WordPress Site URL";s:33:"auth_edwiserbridge_wpsiteurl_help";s:149:"This is necessary to login/logout from WordPress site when a user logs in or logs out from Moodle. Do not forget to add http or https before the URL.";s:46:"auth_edwiserbridge_wpsiteurl_desc_with_warning";s:336:"This is necessary to login/logout from WordPress site when a user logs in or logs out from Moodle. Do not forget to add http or https before the URL.<p><span style = "color:red">Warning: </span><a href ="http://php.net/manual/en/book.mcrypt.php" target="_blank">Mcrypt</a> PHP extension is missing! Enable this to work SSO properly.</p>";s:30:"auth_edwiserbridge_war_warning";s:7:"Warning";s:29:"auth_edwiserbridge_war_mcrypt";s:6:"Mcrypt";s:27:"auth_edwiserbridge_war_desc";s:59:"PHP extension is missing! Enable this to work SSO properly.";s:9:"WordPress";s:9:"WordPress";s:36:"auth_edwiserbridge_logoutredirecturl";s:19:"Logout Redirect URL";s:41:"auth_edwiserbridge_logoutredirecturl_help";s:140:"Users will be redirected to this URL after logout. Keep it blank for default redirection. Do not forget to add http or https before the URL.";s:16:"privacy:metadata";s:59:"The Edwiser Bridge plugin does not store any personal data.";s:35:"auth_edwiserbridge_wploginenablebtn";s:22:"Enable WordPress Login";s:40:"auth_edwiserbridge_wploginenablebtn_help";s:66:"This will enable login with WordPress button on Moodle login page.";s:43:"auth_edwiserbridge_wploginenablebtn_default";s:11:"Default: No";s:33:"auth_edwiserbridge_wploginbtntext";s:20:"WordPress Login Text";s:38:"auth_edwiserbridge_wploginbtntext_help";s:76:"This text will be shown as WordPress login button text on Moodle login page.";s:33:"auth_edwiserbridge_wploginbtnicon";s:20:"WordPress Login Icon";s:38:"auth_edwiserbridge_wploginbtnicon_help";s:76:"This icon will be shown as WordPress login button icon on Moodle login page.";s:35:"auth_edwiserbridge_wploginlogo_desc";s:76:"This logo will be shown as WordPress login button logo on Moodle login page.";s:10:"menuoption";s:18:"auth_edwiserbridge";s:17:"edwiserbridge:add";s:18:"Add Edwiser Bridge";s:9:"api_error";s:21:"Response error status";s:13:"api_error_msg";s:22:"Response error message";s:11:"api_user_id";s:7:"User Id";s:12:"api_username";s:9:"User Name";s:12:"api_password";s:34:"Password used to create the User. ";s:9:"api_email";s:10:"User Email";s:12:"api_enrolled";s:20:"User ENrolled status";s:13:"api_cohort_id";s:9:"Cohort id";s:18:"api_creation_error";s:26:"User creation error status";s:13:"api_firstname";s:15:"User First Name";s:12:"api_lastname";s:14:"User Last Name";s:30:"edwiserbridgepropluginrequired";s:313:" You have tried to install latest version of Edwiser Bridge plugin, but we have noticed you are still using older version of edwiser bridge plugins. please remove older version of moodle edwiser bridge, moodle single sign on and moodle bulk purchase plugin and then try to install the Edwiser Bridge plugin again.";s:8:"fromhere";s:9:"From here";s:18:"settings_migration";s:113:"Edwiser Bridge SSO Settings are now migrated to Edwiser Settings. Please visit Edwiser Settings to configure SSO.";s:24:"pluginrequirementsnotmet";s:107:"Edwiser Bridge SSO plugin requirements are not met. Please install latest version of Edwiser Bridge plugin.";s:20:"backtopluginoverview";s:28:"Back to plugin overview page";s:32:"plugin_update_notification_title";s:38:"Edwiser Bridge - New update available!";s:31:"plugin_update_notification_body";s:116:"A new version of Edwiser Bridge plugin is available. Please update to the latest version to get the latest features.";s:36:"plugin_update_notification_changelog";s:15:" View Changelog";s:15:"plugin_download";s:8:"Download";s:13:"plugin_update";s:10:"Update Now";s:9:"plugin_or";s:2:"or";s:23:"plugin_update_help_text";s:41:"Click here to automatically update plugin";s:21:"plugin_update_dismiss";s:7:"Dismiss";s:26:"plugin_update_notification";s:31:"Show plugin update notification";s:6:"errors";s:6:"Errors";s:10:"invalidzip";s:29:"Invalid zip file. <b>{$a}</b>";s:18:"eb_pro_license_msg";s:83:"<p>Please activate licence from <a href="{$a}">here</a> to access this setting.</p>";s:13:"errorfetching";s:38:"Error fetching plugin ZIP. <b>{$a}</b>";s:18:"errorfetchingexist";s:62:"Error fetching plugin ZIP: target location exists. <b>{$a}</b>";s:13:"unabletounzip";s:27:"Unable to unzip <b>{$a}</b>";s:25:"unabletoloadplugindetails";s:41:"Unable to load Plugin details <b>{$a}</b>";s:20:"requirehigherversion";s:36:"Requires Moodle version: <b>{$a}</b>";s:9:"noupdates";s:25:"Everything is up to date.";s:15:"invalidjsonfile";s:44:"Error: Invalid json of Edwiser product list.";s:14:"recommendation";s:19:"Recommended Plugins";s:9:"comeswith";s:16:"Comes with: {$a}";s:9:"changelog";s:9:"Changelog";s:14:"currentrelease";s:21:"Current release: {$a}";s:15:"updateavailable";s:22:"Update available: {$a}";s:8:"uptodate";s:10:"Up to date";s:10:"updatedown";s:53:"Update service is down temporarily. <br>Error - {$a}.";s:7:"dismiss";s:7:"Dismiss";s:24:"wp_test_connection_token";s:15:"Token to verify";s:15:"settingdisabled";s:8:"Disabled";s:14:"settingenabled";s:7:"Enabled";s:21:"plugin_not_configured";s:99:"Sorry, this plugin has not yet been configured. Please contact the Moodle administrator for details";s:30:"redirecting_to_wp_setup_wizard";s:40:"Redirecting to WordPress Setup wizard...";s:7:"success";s:41:"true if the token matches otherwise false";s:12:"more_details";s:18:"Check more details";s:17:"success_error_msg";s:23:"Success/Failure message";s:33:"wp_test_connection_token_mismatch";s:116:"Token does not match with the existing moodle connection settings. it may cause test connection issue on moodle end.";s:35:"wp_test_connection_function_missing";s:32:"Web service function is missing.";s:36:"wp_test_connection_functions_missing";s:34:"Web service functions are missing.";s:20:"check_wp_site_config";s:42:"Please check WordPress site configuration.";s:26:"test_connection_fail_err_1";s:67:"Test Connection failed, To check more information about issue click";s:35:"test_connection_fail_err_close_link";s:6:" here ";s:26:"test_connection_fail_err_2";s:22:"An issue was detected.";s:26:"test_connection_fail_err_3";s:28:"Status : Connection  Failed ";s:24:"test_connection_fail_url";s:5:"Url :";s:29:"test_connection_fail_response";s:10:"Response :";s:25:"test_connection_fail_next";s:193:"Next Steps: Please refresh the page and try again. If this still doesnt work. Go to <a href="{$a}" target="_blank"> Connection Settings </a> and click the <strong>Troubleshoot</strong> button .";s:21:"invalid_sso_token_err";s:55:"Invalid token provided,please check token and try again";s:23:"valid_sso_token_success";s:27:"Token verified successfully";s:21:"incomplete_caps_error";s:54:"User don't have web service access capabilities, click";s:31:"incomplete_caps_error_know_more";s:13:"to know more.";s:23:"installation_free_guide";s:45:"Edwiser Bridge FREE plugin installation guide";s:17:"mdl_plugin_config";s:44:"Edwiser Bridge - Moodle Plugin configuration";s:17:"web_service_setup";s:22:"Setting up Web service";s:22:"wordpress_site_details";s:22:"WordPress site details";s:15:"check_permalink";s:25:"Check permalink structure";s:15:"test_connection";s:44:"Test connection between Moodle and WordPress";s:20:"user_and_course_sync";s:31:"Setting up User and course sync";s:16:"complete_details";s:48:"Edwiser Bridge FREE Moodle plugin setup complete";s:30:"web_service_validate_token_msg";s:27:"Return true if tokens match";s:29:"web_service_validate_user_msg";s:41:"Return true if user is manager/site admin";s:8:"checking";s:11:"Checking...";}