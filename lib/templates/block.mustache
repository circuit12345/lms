          </div>
          <a href="#" class="btn btn-primary w-100" 
           style = "margin-top:30px; background: linear-gradient(135deg, #6366f1, #4f46e5);">Start Learning →</a>
        </div>
      </div>
    </div>
  </div>
</div>


