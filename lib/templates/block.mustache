{{!
    Custom Dashboard UI Template
}}

{{!
    @template core/block

    Example context (json):
    {
        "id": "block0",
        "class": "block block_html",
        "showskiplink": true,
        "type": "html",
        "ariarole": "",
        "title": "Test block",
        "blockinstanceid": 1,
        "content": "<p>Hello block world!</p>"
    }

}}

{{! Start Block Container }}
<section id="{{id}}"
     class="{{#hidden}}hidden{{/hidden}} {{class}} {{#hascontrols}}block_with_controls{{/hascontrols}} card mb-3"
     {{#ariarole}}role="{{.}}"{{/ariarole}}
     data-block="{{type}}"
     data-instance-id="{{blockinstanceid}}"
     {{#arialabel}}
        aria-label="{{arialabel}}"
     {{/arialabel}}
     {{^arialabel}}
        {{#title}}
          aria-labelledby="instance-{{blockinstanceid}}-header"
        {{/title}}
     {{/arialabel}}>

    {{! Block contents }}

<style>
.dashboard-wrapper {
  background: #f8fafc;
}

.welcome-banner {
  border-left: 6px solid #50c878;
}

.course-card {
  min-height: 160px;
}

.bg-gradient-primary {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
}

.bg-gradient-success {
  background: linear-gradient(135deg, #059669, #10b981);
}

.bg-gradient-info {
  background: linear-gradient(135deg, #0ea5e9, #38bdf8);
}

.explore-card {
  min-height: 200px;
}

</style>

  <!-- Welcome Banner -->
  
  <div class="welcome-banner bg-white rounded-2xl shadow-sm p-6 mb-6">
    <h2 class="text-xl fw-bold mb-2">Welcome, New Student! 🎉</h2>
    <p class="text-muted">Ready to explore Programming Courses?</p>
    <div class="d-flex justify-content-between align-items-center mt-3">
      <span class="badge bg-light text-dark p-2">0 Points</span>
      <span class="small text-muted">Assessment: 67%</span>
    </div>
  </div>


<div class="dashboard-wrapper p-4">

<!-- AI Recommended Courses -->
<div class="recommended-courses mb-6">
