            <span>45 min</span>
            <span class="text-success fw-bold">200 pts</span>
          </div>
          <a href="#" class="btn btn-primary w-100"
            style = "margin-top:10px; background: linear-gradient(135deg, #3b82f6, #2563eb);">Start Learning →</a>
        </div>
      </div>
    </div>

    <!-- Card 2 -->
    <div class="col-md-4">
      <div class="card shadow-sm border-0 rounded-3 h-100">
        <div class="p-4 text-white rounded-top-3" 
             style="background: linear-gradient(135deg, #10b981, #059669);">
          <span class="badge bg-light text-dark">88% Match</span>
        </div>
        <div class="card-body">
          <h5 class="fw-bold">Cloud Computing</h5>
          <p class="text-muted mb-2">Based on your assessment performance</p>
          <div class="d-flex justify-content-between small mb-3">
            <span class="badge bg-light text-dark">Advanced</span>
            <span>60 min</span>
            <span class="text-success fw-bold">300 pts</span>
          </div>
          <a href="#" class="btn btn-success w-100"
           style = "margin-top:30px; background: linear-gradient(135deg, #10b981, #059669); color: white">Start Learning →</a>
        </div>
      </div>
    </div>

    <!-- Card 3 -->
    <div class="col-md-4">
      <div class="card shadow-sm border-0 rounded-3 h-100">
        <div class="p-4 text-white rounded-top-3" 
             style="background: linear-gradient(135deg, #6366f1, #4f46e5);">
          <span class="badge bg-light text-dark">82% Match</span>
        </div>
        <div class="card-body">
          <h5 class="fw-bold">Machine Learning</h5>
