<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/jobboard/db" VERSION="2025081700" COMMENT="Jobboard tables" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <TABLES>

    <TABLE NAME="jobboard_jobs" COMMENT="Job postings">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="summary" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="location" TYPE="char" LENGTH="255" NOTNULL="false"/>
        <FIELD NAME="jobtype" TYPE="char" LENGTH="50" NOTNULL="false"/>
        <FIELD NAME="tags" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="salaryrange" TYPE="char" LENGTH="100" NOTNULL="false"/>
        <FIELD NAME="applydeadline" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="published" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="createdby" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="published_idx" UNIQUE="false" FIELDS="published"/>
        <INDEX NAME="deadline_idx" UNIQUE="false" FIELDS="applydeadline"/>
        <INDEX NAME="timemodified_idx" UNIQUE="false" FIELDS="timemodified"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="jobboard_applications" COMMENT="Applications to jobs">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="jobid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="coverletter" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="submitted"/>
        <FIELD NAME="statusnote" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="assignedto" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="jobid_fk" TYPE="foreign" FIELDS="jobid" REFTABLE="jobboard_jobs" REFFIELDS="id"/>
        <KEY NAME="userid_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="assignedto_fk" TYPE="foreign" FIELDS="assignedto" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="job_user_uq" UNIQUE="true" FIELDS="jobid,userid"/>
        <INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>
        <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="jobboard_customfields" COMMENT="Per-job custom application fields">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="jobid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="type" TYPE="char" LENGTH="32" NOTNULL="true"/>
        <FIELD NAME="options" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="required" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="jobid_fk" TYPE="foreign" FIELDS="jobid" REFTABLE="jobboard_jobs" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="jobid_idx" UNIQUE="false" FIELDS="jobid"/>
        <INDEX NAME="sortorder_idx" UNIQUE="false" FIELDS="sortorder"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="jobboard_answers" COMMENT="Applicant answers to custom fields">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="applicationid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="fieldid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="value" TYPE="text" NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="application_fk" TYPE="foreign" FIELDS="applicationid" REFTABLE="jobboard_applications" REFFIELDS="id"/>
        <KEY NAME="field_fk" TYPE="foreign" FIELDS="fieldid" REFTABLE="jobboard_customfields" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="app_field_idx" UNIQUE="false" FIELDS="applicationid,fieldid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="jobboard_activitylog" COMMENT="Log of status changes/notes">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="applicationid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="action" TYPE="char" LENGTH="64" NOTNULL="true"/>
        <FIELD NAME="actorid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="notetext" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="application_fk" TYPE="foreign" FIELDS="applicationid" REFTABLE="jobboard_applications" REFFIELDS="id"/>
        <KEY NAME="actor_fk" TYPE="foreign" FIELDS="actorid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="application_idx" UNIQUE="false" FIELDS="applicationid"/>
        <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
